# Copy this file to keystore.properties (same folder, repo root) and fill in
# your own values. keystore.properties and the .jks/.keystore file it points
# to are both gitignored — never commit either one.
#
# Generate a keystore first if you don't have one:
#   keytool -genkeypair -v -keystore cytube-release.jks -alias cytube \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repo root.

storeFile=cytube-release.jks
storePassword=
keyAlias=cytube
keyPassword=
