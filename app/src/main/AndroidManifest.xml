<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <!-- Fire TV / Android TV: neither a Leanback UI nor a touchscreen is
         actually required for this app to run (D-pad can drive standard
         Compose focus/click same as a remote's OK button), so both are
         declared optional. Without this pair the Amazon Appstore and Google
         Play both treat the app as phone/tablet-only and hide it from TV
         devices entirely. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".CyTubeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CyTube">

        <!-- windowSoftInputMode is explicit rather than left to the platform
             default: with enableEdgeToEdge() (MainActivity) the window no
             longer resizes/pans itself for insets in principle, but leaving
             this unset still let some OS versions/OEM skins apply their own
             legacy pan/resize on top of Panels.kt's own imePadding() — the
             two stacking is what was pushing the chat input way higher than
             the keyboard actually needs and leaving a dead gap above it.
             adjustResize with no window-level resize actually happening
             (edge-to-edge) means Compose's own imePadding()/WindowInsets.ime
             is the ONLY thing moving anything, so there's exactly one shift,
             not two. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|layoutDirection"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.CyTube"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Puts the app on the Fire TV / Android TV home screen
                     launcher row; ignored by phones and tablets. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Open cytu.be channel links directly in the app. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cytu.be" android:pathPrefix="/r/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
